{
 "xsappname": "invoicemanagement",
 "tenant-mode": "dedicated",
 "scopes": [
  {
   "name": "$XSAPPNAME.Display",
   "description": "display"
  },
  {
   "name": "$XSAPPNAME.Edit",
   "description": "edit"
  },
  {
   "name": "$XSAPPNAME.Delete",
   "description": "delete"
  }
 ],
 "role-templates": [
  {
   "name": "Viewer",
   "description": "View all data of Invoice data",
   "default-role-name": "Viewer: Authorized to Read All Invoice data",
   "scope-references": [
    "$XSAPPNAME.Display"
   ]
  },
  {
   "name": "Editor",
   "description": "Edit, delete Invoice data",
   "scope-references": [
    "$XSAPPNAME.Edit",
    "$XSAPPNAME.Delete"
   ]
  }
 ],
 "authorities": [
  "$ACCEPT_GRANTED_AUTHORITIES"
 ],
 "oauth2-configuration": {
  "token-validity": 9000,
  "redirect-uris": [
   "https://*.cfapps.us10-001.hana.ondemand.com/login/callback"
  ]
 },
 "xsenableasyncservice": "true"
}
